# ════════════════════════════════════════════════════════════════
#  TriTransportes — Seguridad + URLs limpias (sin .php)
# ════════════════════════════════════════════════════════════════
Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php index.html

# ---- Cabeceras de seguridad ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https://api.groq.com"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Forzar HTTPS (sin bucle detrás de proxy que ya sirve https) ----
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---- Código, dependencias, pruebas y migraciones no se sirven por web ----
    RewriteRule ^(vendor|src|tests|database|docker)(/|$) - [F,L]
    RewriteRule ^(phinx\.php|phpunit\.xml(\.dist)?|Dockerfile|docker-compose\.ya?ml)$ - [F,L]

    # ---- URLs limpias: redirigir GET /algo.php -> /algo (excepto /api/) ----
    RewriteCond %{THE_REQUEST} ^GET\s
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !/api/ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # ---- Mapear internamente /algo -> /algo.php si el archivo existe ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# ---- Proteger archivos sensibles ----
<FilesMatch "(^\.env.*|^\.git.*|bootstrap\.php|config\.php|database\.php|session\.php|secrets\.php|\.sql|\.log|\.md|\.txt|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# ---- Tipos MIME de la aplicación instalable (PWA) ----
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript            .js
    AddType image/svg+xml              .svg
</IfModule>

# El service worker no debe quedar cacheado: si no, los usuarios se
# quedarían con una versión antigua de la aplicación.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </IfModule>
</Files>

# ---- Cache de assets estáticos ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png            "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 1 month"
</IfModule>

# ---- Ocultar el repositorio Git ----
RedirectMatch 404 /\.git
